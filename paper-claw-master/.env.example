# Paper Claw / CHATAGENT shared environment (copy to .env; never commit secrets)
PAPER_CLAW_ENVIRONMENT=development
PAPER_CLAW_DATABASE_URL=postgresql+psycopg://paper_claw:paper_claw@localhost:5432/paper_claw
PAPER_CLAW_DATA_DIR=./data

# The same OpenAI-compatible chat endpoint is used by chat, HARNESS,
# paper analysis and reports. CHATAGENT_* aliases are also accepted.
PAPER_CLAW_CHAT_API_KEY=
PAPER_CLAW_CHAT_BASE_URL=
PAPER_CLAW_CHAT_MODEL=
CHATAGENT_API_KEY=
CHATAGENT_BASE_URL=
CHATAGENT_MODEL=
PAPER_CLAW_CHAT_TEMPERATURE=0.2
PAPER_CLAW_CHAT_MAX_TOKENS=4096
PAPER_CLAW_CHAT_TIMEOUT_SECONDS=120
PAPER_CLAW_CHAT_MAX_RETRIES=2

# arXiv does not require an API key. These values control rate limiting.
PAPER_CLAW_ARXIV_MIN_INTERVAL_SECONDS=3
PAPER_CLAW_ARXIV_MAX_RETRIES=3
PAPER_CLAW_ARXIV_BACKOFF_BASE_SECONDS=1
PAPER_CLAW_ARXIV_BACKOFF_MAX_SECONDS=30
PAPER_CLAW_ARXIV_TIMEOUT_SECONDS=30

# OpenAlex key is optional, but a real contact email is recommended for the
# polite pool and to avoid 429 responses. Do not use a placeholder in .env.
PAPER_CLAW_OPENALEX_EMAIL=
PAPER_CLAW_OPENALEX_API_KEY=
PAPER_CLAW_OPENALEX_TIMEOUT_SECONDS=30

# Embeddings: use local fastembed by default, or point at the same compatible
# endpoint with CHATAGENT_API_KEY/CHATAGENT_BASE_URL when using a remote model.
PAPER_CLAW_EMBEDDING_PROVIDER=local
PAPER_CLAW_EMBEDDING_API_KEY=
PAPER_CLAW_EMBEDDING_BASE_URL=
PAPER_CLAW_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
PAPER_CLAW_EMBEDDING_DIMENSION=512

# Optional parser services
PAPER_CLAW_LOCAL_OCR_API_KEY=EMPTY
PAPER_CLAW_LOCAL_OCR_BASE_URL=
PAPER_CLAW_LLAMA_PARSE_API_KEY=
PAPER_CLAW_DB_CONNECT_TIMEOUT_SECONDS=5
PAPER_CLAW_DB_POOL_SIZE=10
PAPER_CLAW_DB_MAX_OVERFLOW=20
