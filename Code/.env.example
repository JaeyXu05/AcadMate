PORT=3001
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# A-side HARNESS service
MENTOR_AGENT_BASE_URL=http://127.0.0.1:8000
MENTOR_AGENT_TIMEOUT_MS=420000
REPORT_AGENT_TIMEOUT_MS=180000
PDF_AGENT_TIMEOUT_MS=360000
PDF_MAX_ANALYSIS_PAGES=64
PDF_MAX_ANALYSIS_CHARS=120000
EMAIL_AGENT_TIMEOUT_MS=150000
PLAN_AGENT_TIMEOUT_MS=150000
MENTOR_AGENT_POLL_MS=1000

# Outgoing mail (reports, reminders, advisor contact)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=account@example.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM=科研导师推荐平台 <account@example.com>

# Optional inbox. For privacy, only a platform user whose registered address
# equals IMAP_USER may open this inbox through the UI.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=account@example.com
IMAP_PASS=replace-with-an-app-password
IMAP_MAILBOX=INBOX
