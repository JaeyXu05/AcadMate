# ===== JWT 密钥 =====
# 必须为随机长字符串（>=16 位，且不得为默认值），后端启动时校验，否则拒绝启动。
# 生成方式：openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_string_at_least_16_chars

# ===== 后端端口 =====
PORT=3001

# ===== CORS 允许来源（逗号分隔）=====
# 本地开发默认 5173（Vite）；部署时改为前端实际域名
CORS_ORIGINS=http://localhost:5173

# ===== 检索智能体代理（A 后端 mentor-workflows 轮询）=====
# 留空/连不上时自动回退到本地 stub 假数据
MENTOR_AGENT_BASE_URL=http://localhost:8000
MENTOR_AGENT_TIMEOUT_MS=180000
MENTOR_AGENT_POLL_MS=1200